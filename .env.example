# 复制本文件为 .env 并填入真实值
# API Key 申请：https://bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=your-api-key-here

# 以下均有默认值，按需覆盖
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_MODEL=glm-5.2
EMBED_MODEL=embedding-3
EMBED_DIM=1024

# 分块与检索
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# 访问口令（可选）。公网部署时强烈建议设置：
# 开启后浏览器会弹出登录框，用户名随意填，密码即此值。
# 不设置则不校验，任何人访问你的地址都会消耗你的 API Key。
APP_PASSWORD=
