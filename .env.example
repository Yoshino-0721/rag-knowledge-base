# 复制本文件为 .env 并填入真实值
# API Key 申请：https://bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=your-api-key-here

# 以下均有默认值，按需覆盖
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_MODEL=glm-5.2
EMBED_MODEL=embedding-3
EMBED_DIM=1024

# 分块与检索
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# 送入精排的候选数（先宽召回、再精排截取 TOP_K）。智谱 rerank 单次上限 128。
RERANK_CANDIDATES=20

# 多轮对话
# 携带的历史轮数（1 轮 = 一问一答），0 表示不记忆上下文；
# QUERY_REWRITE 打开后，带指代的追问（「它的优势是什么」）会先改写成
# 可独立检索的问题再去查库，否则这类追问基本命中不到内容。
HISTORY_TURNS=6
QUERY_REWRITE=true

# 精排（Rerank）：用一个专门的排序模型对召回结果重新打分排序。
# 关掉也能用，只是召回精度会降一档。
RERANK_ENABLED=true
RERANK_MODEL=rerank

# ---- 多用户系统 ----
# JWT 签名密钥（强烈建议设置一串随机长字符串；不设则首次启动自动生成并
# 持久化到 storage/secret.key）。登录态有效期默认 7 天（JWT_EXPIRE_HOURS）。
JWT_SECRET=
# JWT_EXPIRE_HOURS=168

# 首次启动引导创建的管理员（users 表为空时生效）。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 默认口令 admin123（启动日志会警告提醒修改）。可用此变量指定初始口令。
ADMIN_PASSWORD=
