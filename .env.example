# 复制本文件为 .env 并填入真实值
# API Key 申请：https://bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=your-api-key-here

# 以下均有默认值，按需覆盖
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_MODEL=glm-5.2
EMBED_MODEL=embedding-3
EMBED_DIM=1024

# 分块与检索
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# 送入精排的候选数（先宽召回、再精排截取 TOP_K）。智谱 rerank 单次上限 128。
RERANK_CANDIDATES=20

# 多轮对话
# 携带的历史轮数（1 轮 = 一问一答），0 表示不记忆上下文；
# QUERY_REWRITE 打开后，带指代的追问（「它的优势是什么」）会先改写成
# 可独立检索的问题再去查库，否则这类追问基本命中不到内容。
HISTORY_TURNS=6
QUERY_REWRITE=true

# 精排（Rerank）：用一个专门的排序模型对召回结果重新打分排序。
# 关掉也能用，只是召回精度会降一档。
RERANK_ENABLED=true
RERANK_MODEL=rerank

# ---- 多用户系统 ----
# 运行环境：dev（默认）/ production。
# 非 dev 时代码会强制要求外部注入 JWT_SECRET，缺了直接拒绝启动（fail fast）。
APP_ENV=dev

# JWT 签名密钥：dev 下不设会自动生成并持久化到 storage/secret.key；
# production 下**必须**显式注入，且多实例部署必须用同一个值。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_EXPIRE_HOURS=168

# 首次启动引导创建的管理员（users 表为空时生效）。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 初始口令。**这里没有默认口令**：
#   - 留空 → 系统生成随机强口令，在启动日志里用醒目横幅打印一次，
#            并强制该账号首次登录后改密（改密前除 /api/auth/me 与改密接口外一律 403）；
#   - 填了 → 直接用它，但弱口令会让服务**拒绝启动**：要求 ≥12 位、
#            至少 3 类字符（大小写/数字/符号），且不在常见弱口令表里（如 admin123）。
ADMIN_PASSWORD=

# ---- 注册与登录节流 ----
# 是否允许自助注册。**默认关闭**：公网部署下，任何人注册成功都会消耗**站点共用**的
# API Key 额度（上传文档要 embedding、提问要 chat）。需要开通成员时临时设为 true，
# 开通完再改回 false 并重启。
ALLOW_REGISTRATION=false

# 登录节流：同一账号连续失败 N 次后锁定 M 秒，期间登录返回 429。
# 计数在**进程内存**里 —— 多 worker / 多实例部署时各自计数，实际阈值会变成 N 倍。
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# ---- 上传体积上限 ----
# 单次上传请求的**总体积**上限（字节，多个文件共享同一份预算），默认 50 MiB。
# 超限返回 413。实现是两道闸门：先按 Content-Length 快速拒绝，
# 再在读取时按累计字节兜底（只信请求头会被伪造头或 chunked 编码绕过）。
MAX_UPLOAD_SIZE=52428800

